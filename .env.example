# Copy to .env and fill in.
DOMAIN=cards.example.com
BASE_URL=https://cards.example.com
# Long random string; enables POST /api/admin/cards/:id/unpublish
ADMIN_TOKEN=
# "Report this card" opens the visitor's mail app addressed here, with the
# card URL prefilled. Empty = in-page prompt flow instead.
REPORT_EMAIL=me@mal7othify.com
# Analytics - leave empty to disable. Either or both:
# Cloudflare Web Analytics beacon token (dashboard: Analytics -> Web Analytics)
CF_BEACON_TOKEN=
# Umami instance script URL + website id
UMAMI_SRC=
UMAMI_WEBSITE_ID=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Note: unlike the two
# options above, GA sets cookies in visitors' browsers.
GA_MEASUREMENT_ID=
