# Copy to .env and fill in.
DOMAIN=cards.example.com
BASE_URL=https://cards.example.com
# Long random string; enables POST /api/admin/cards/:id/unpublish
ADMIN_TOKEN=
# Analytics (spec §9) - leave empty to disable. Either or both:
# Cloudflare Web Analytics beacon token (dashboard: Analytics -> Web Analytics)
CF_BEACON_TOKEN=
# Umami instance script URL + website id
UMAMI_SRC=
UMAMI_WEBSITE_ID=
